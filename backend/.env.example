NODE_ENV=development
PORT=5000
TRUST_PROXY=false

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/erms?retryWrites=true&w=majority

# JWT — generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_32_byte_hex
JWT_REFRESH_SECRET=replace_me_with_32_byte_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173
BCRYPT_ROUNDS=12

# Super admin bootstrap (used only by seed script)
SUPER_ADMIN_EMAIL=admin@codesmartng.example
SUPER_ADMIN_PASSWORD=ChangeMeNow!2026
SUPER_ADMIN_FIRST_NAME=System
SUPER_ADMIN_LAST_NAME=Administrator
